{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-close-editor-window",
    "allow-load-workspace-file",
    "allow-save-workspace-file",
    "allow-workspace-data-directory",
    "allow-agent-provider-status",
    "allow-agent-ask"
  ]
}
