{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-close-editor-window",
    "allow-load-workspace-file",
    "allow-save-workspace-file",
    "allow-workspace-data-directory",
    "allow-agent-provider-status",
    "allow-agent-ask",
    "allow-load-cloud-session",
    "allow-save-cloud-session",
    "allow-agent-cancel",
    "allow-ai-local-status",
    "allow-ai-local-save",
    "allow-ai-local-delete",
    "allow-ai-local-models",
    "allow-ai-local-respond",
    "allow-ai-local-cancel"
  ]
}
