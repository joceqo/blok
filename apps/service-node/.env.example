# Copy to .env for local development (do not commit .env).

PORT=8080

# Matches docker-compose.dev.yml defaults
DATABASE_URL=postgres://blok:blok@127.0.0.1:5432/blok

# Apply schema.sql on boot when the database is empty (handy for first run)
APPLY_SCHEMA_ON_BOOT=1

# --- Optional ---

# BLOK_SECRET=replace-with-at-least-32-characters-for-tickets
# BLOK_SIDECAR_URL=http://127.0.0.1:4000
# DEV_EXPOSE_AUTH_CODE=1
# PUBLIC_URL=http://127.0.0.1:8080
# ADMIN_USER_IDS=
# AUTH_LOG_CODE=1
# MAILER_HOST=
# SMTP_HOST=