{$DOMAIN} {
  encode zstd gzip
  @private path /internal/*
  respond @private 404
  @api path /api/* /files/* /healthz /mcp
  handle @api {
    reverse_proxy app:8080
  }
  handle {
    root * /srv
    try_files {path} /index.html
    @html path / /index.html
    header @html Cache-Control "no-cache"
    file_server
  }
  header {
    # Laisse ?profile=1 échantillonner le démarrage. Posé ici et non sur @html :
    # ce matcher ne voit que / et /index.html, jamais une route SPA /p/…,
    # qui est précisément celle dont le démarrage gèle.
    Document-Policy "js-profiling"
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
  }
}
