{$DOMAIN} {
  encode zstd gzip
  handle /internal/* {
    respond 404
  }
  @shellReads {
    method GET HEAD
    path_regexp shellReads ^/api/(session|workspaces|workspaces/[^/]+/(index|members|pages/[^/]+(/access)?))$
  }
  handle @shellReads {
    reverse_proxy {$BLOK_SHELL_READ_UPSTREAM:app:8080}
  }
  @shellPut {
    method PUT
    path_regexp shellPut ^/api/workspaces/[^/]+/(index|pages/[^/]+/(access|shares/[^/]+))$
  }
  @shellDelete {
    method DELETE
    path_regexp shellDelete ^/api/workspaces/[^/]+/pages/[^/]+/shares/[^/]+$
  }
  handle @shellPut {
    reverse_proxy {$BLOK_SHELL_WRITE_UPSTREAM:app:8080}
  }
  handle @shellDelete {
    reverse_proxy {$BLOK_SHELL_WRITE_UPSTREAM:app:8080}
  }
  @workspaceSearch {
    method POST
    path_regexp workspaceSearch ^/api/workspaces/[^/]+/search$
  }
  handle @workspaceSearch {
    reverse_proxy {$BLOK_SHELL_READ_UPSTREAM:app:8080}
  }
  @membership {
    method PATCH DELETE
    path_regexp membership ^/api/workspaces/[^/]+/members/[^/]+$
  }
  handle @membership {
    reverse_proxy {$BLOK_SHELL_WRITE_UPSTREAM:app:8080}
  }
  @teamspaces {
    method GET HEAD OPTIONS POST PUT PATCH DELETE
    path_regexp teamspaces ^/api/workspaces/[^/]+/teamspaces(/[^/]+(/(members|pages)(/[^/]+)?)?)?$
  }
  handle @teamspaces {
    reverse_proxy {$BLOK_SHELL_WRITE_UPSTREAM:app:8080}
  }
  @api path /api/* /files/* /healthz /mcp
  handle @api {
    reverse_proxy app:8080
  }
  handle {
    root * /srv
    try_files {path} /index.html
    @html path / /index.html
    header @html Cache-Control "no-cache"
    file_server
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
  }
}
