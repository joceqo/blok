DOMAIN=blok.tousamba.cloud
# Generated hex passwords avoid URI escaping in DATABASE_URL.
POSTGRES_PASSWORD=
TICKET_SECRET=
INTERNAL_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
# Verify the sending domain in Resend before using this address.
MAIL_FROM=Blok <connexion@tousamba.cloud>
RESEND_API_KEY=
# Native Tauri webview origins, not public browser sites.
ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
APP_IMAGE=blok-cloud-app:local
WEB_IMAGE=blok-cloud-web:local
# Change all three if this private subnet is already in use on the host.
BLOK_NETWORK_SUBNET=172.30.87.0/24
BLOK_NETWORK_DYNAMIC_RANGE=172.30.87.128/25
CADDY_IP=172.30.87.3
