DOMAIN=blok.example.com
# Generated hex passwords avoid URI escaping in DATABASE_URL.
POSTGRES_PASSWORD=
TICKET_SECRET=
INTERNAL_SECRET=
# Optional: skip the first-run setup assistant by promoting this address.
BOOTSTRAP_ADMIN_EMAIL=
# Optional couple (both set or both empty). With BOOTSTRAP_ADMIN_EMAIL, seeds one workspace.
BOOTSTRAP_WORKSPACE_SLUG=
BOOTSTRAP_WORKSPACE_NAME=
# SMTP: port 465 uses implicit TLS; other ports require STARTTLS in production.
MAILER_HOST=smtp.example.com
MAILER_PORT=465
# Leave both empty only when your relay permits sending without authentication.
MAILER_USER=
MAILER_PASSWORD=
MAILER_FROM_EMAIL=blok@example.com
MAILER_FROM_NAME=blok
# Optional alternative to SMTP. Leave empty when using MAILER_*.
RESEND_API_KEY=
MAIL_FROM=
# Native Tauri webview origins, not public browser sites.
ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
APP_IMAGE=blok-cloud-app:local
WEB_IMAGE=blok-cloud-web:local
# Change all three if this private subnet is already in use on the host.
BLOK_NETWORK_SUBNET=172.30.87.0/24
BLOK_NETWORK_DYNAMIC_RANGE=172.30.87.128/25
CADDY_IP=172.30.87.3

# Optional: base64 of 32 random bytes. Otherwise generated once in /data/ai-key.
# Preserve this value with backups; changing it does not rotate existing credentials.
AI_ENCRYPTION_KEY=
